# LLM Configuration (Gemini is the default provider)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_TEMPERATURE=0.0
ENABLE_LLM_PLANNER=true
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional alternative providers (if switching LLM_PROVIDER to openai or anthropic)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Storage & Runtime Paths
TELEMETRY_DATASET_PATH=data/device-telemetry-dataset.ndjson
TELEMETRY_DB_PATH=runtime/fleet_copilot.db
CHECKPOINT_DB_PATH=runtime/langgraph_checkpoints.db
AUDIT_LOG_JSONL_PATH=runtime/audit_log.jsonl

# Optional Real External Action Integrations (leave empty to use local transactional ITSM DB only)
# ACTION_WEBHOOK_URL=https://hooks.example.com/rayda-actions
# ACTION_WEBHOOK_SECRET=
# SLACK_WEBHOOK_URL=
